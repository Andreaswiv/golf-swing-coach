# Copy to .env to override defaults. Docker Compose reads it automatically.
# The defaults are fine for local use; change the password if you ever expose the database.

POSTGRES_DB=golfcoach
POSTGRES_USER=golfcoach
POSTGRES_PASSWORD=golfcoach_dev

# Pose model size: lite (fastest) | full | heavy (default: most accurate, slowest on CPU; full swaps
# the arms more often from down-the-line).
# Changing this requires rebuilding the cv-service image: docker compose build cv-service
POSE_MODEL_VARIANT=heavy

# Longest video side (px) used for pose estimation. Lower = faster, higher = better at small/far golfers.
MAX_PROCESS_DIM=1280

# How many people the pose model may return per frame (used to warn about multiple people).
NUM_POSES=2

# Upload size limit in megabytes (the frontend shows the same limit).
UPLOAD_MAX_MB=500
